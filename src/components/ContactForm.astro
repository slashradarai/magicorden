---
import { CONTACT_FORM_ENDPOINT, PRIVACY_URL, SOCIAL } from '../config';
import { t, type Locale } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale).form;
const services = t(locale).servicios.items;

const live = Boolean(CONTACT_FORM_ENDPOINT);

/* Inputs follow the design system: no four-sided boxes, a filled surface with
   a single heavier bottom edge. */
const field =
  'w-full bg-surface-highest px-4 py-3 font-body text-on-surface border-b-2 border-outline-variant ' +
  'transition-colors duration-200 focus:border-primary focus:outline-none disabled:opacity-50';
const label = 'label-caps mb-2 block text-on-surface-variant';
---
<div class="h-full overflow-y-auto px-6 py-6 md:px-8">
  {!live && (
    <p class="mb-6 bg-surface-highest px-4 py-3 font-body text-sm text-on-surface-variant">
      {c.notLive}
      {SOCIAL.instagram && (
        <>
          {' '}
          <a href={SOCIAL.instagram} target="_blank" rel="noopener" class="text-primary underline underline-offset-4">
            Instagram
          </a>
        </>
      )}
    </p>
  )}

  <p class="mb-6 font-body text-on-surface-variant">{c.intro}</p>

  <form id="contact-form" novalidate data-endpoint={CONTACT_FORM_ENDPOINT} class="flex flex-col gap-5">
    <!-- Honeypot. Real people leave it empty; most bots fill it in. -->
    <div class="absolute left-[-9999px]" aria-hidden="true">
      <label for="cf-company">Company</label>
      <input type="text" id="cf-company" name="company" tabindex="-1" autocomplete="off" />
    </div>

    <div>
      <label class={label} for="cf-name">{c.name}</label>
      <input class={field} type="text" id="cf-name" name="name" required autocomplete="name" disabled={!live} />
      <p class="mt-1 hidden font-body text-xs text-error" data-error-for="cf-name">{c.required}</p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div>
        <label class={label} for="cf-email">{c.email}</label>
        <input class={field} type="email" id="cf-email" name="email" required autocomplete="email" disabled={!live} />
        <p class="mt-1 hidden font-body text-xs text-error" data-error-for="cf-email">{c.invalidEmail}</p>
      </div>
      <div>
        <label class={label} for="cf-phone">{c.phone}</label>
        <input class={field} type="tel" id="cf-phone" name="phone" autocomplete="tel" disabled={!live} />
      </div>
    </div>

    <div>
      <label class={label} for="cf-service">{c.service}</label>
      <select class={field} id="cf-service" name="service" disabled={!live}>
        <option value="">{c.servicePick}</option>
        {services.map((s) => <option value={s.title}>{s.title}</option>)}
        <option value="other">{c.serviceOther}</option>
      </select>
    </div>

    <div>
      <label class={label} for="cf-message">{c.message}</label>
      <textarea class={`${field} resize-y`} id="cf-message" name="message" rows="4" required disabled={!live}></textarea>
      <p class="mt-1 hidden font-body text-xs text-error" data-error-for="cf-message">{c.required}</p>
    </div>

    <div>
      <label class="flex cursor-pointer items-start gap-3 font-body text-sm text-on-surface-variant">
        <input
          type="checkbox"
          id="cf-consent"
          name="consent"
          required
          disabled={!live}
          class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-primary)]"
        />
        <span>
          {c.consent}
          {PRIVACY_URL && (
            <>
              {' '}
              <a href={PRIVACY_URL} class="text-primary underline underline-offset-4">{c.privacyLink}</a>
            </>
          )}
        </span>
      </label>
      <p class="mt-1 hidden font-body text-xs text-error" data-error-for="cf-consent">{c.required}</p>
    </div>

    <button
      type="submit"
      disabled={!live}
      class="mt-2 rounded bg-primary px-8 py-4 font-body font-medium text-on-primary transition-all duration-300 hover:bg-primary-dim disabled:cursor-not-allowed disabled:opacity-40"
      data-submit
      data-label-idle={c.submit}
      data-label-sending={c.sending}
    >
      {c.submit}
    </button>

    <p class="hidden bg-surface-highest px-4 py-3 font-body text-sm text-primary" data-form-success>{c.success}</p>
    <p class="hidden bg-surface-highest px-4 py-3 font-body text-sm text-error" data-form-error>{c.error}</p>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const endpoint = form.dataset.endpoint;
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const okMsg = form.querySelector<HTMLElement>('[data-form-success]');
    const errMsg = form.querySelector<HTMLElement>('[data-form-error]');

    const showError = (id: string, show: boolean) =>
      form.querySelector(`[data-error-for="${id}"]`)?.classList.toggle('hidden', !show);

    const validate = () => {
      const name = form.querySelector<HTMLInputElement>('#cf-name')!;
      const email = form.querySelector<HTMLInputElement>('#cf-email')!;
      const message = form.querySelector<HTMLTextAreaElement>('#cf-message')!;
      const consent = form.querySelector<HTMLInputElement>('#cf-consent')!;

      const checks: [string, boolean][] = [
        ['cf-name', name.value.trim().length > 0],
        ['cf-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())],
        ['cf-message', message.value.trim().length > 0],
        ['cf-consent', consent.checked],
      ];
      checks.forEach(([id, ok]) => showError(id, !ok));
      return checks.every(([, ok]) => ok);
    };

    // Clear a field's error as soon as the person starts fixing it, rather
    // than leaving it shouting until the next submit.
    ['cf-name', 'cf-email', 'cf-message'].forEach((id) => {
      form.querySelector(`#${id}`)?.addEventListener('input', () => showError(id, false));
    });
    form.querySelector('#cf-consent')?.addEventListener('change', () => showError('cf-consent', false));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!endpoint) return;

      okMsg?.classList.add('hidden');
      errMsg?.classList.add('hidden');
      if (!validate()) return;

      // Silently succeed for bots so they do not retry.
      const data = Object.fromEntries(new FormData(form).entries());
      if (data.company) {
        okMsg?.classList.remove('hidden');
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = btn.dataset.labelSending ?? '';
      }

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, locale: document.documentElement.lang }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        okMsg?.classList.remove('hidden');
      } catch {
        errMsg?.classList.remove('hidden');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = btn.dataset.labelIdle ?? '';
        }
      }
    });
  }
</script>

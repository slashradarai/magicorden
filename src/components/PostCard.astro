---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AuthorAvatar from './AuthorAvatar.astro';
import { AUTHOR } from '../config';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const d = post.data;

const date = d.pubDate.toLocaleDateString('es-ES', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---
<article class="group flex flex-col bg-surface-lowest transition-colors duration-500 hover:bg-surface-container">
  <a href={`/blog/${post.id}/`} class="flex flex-1 flex-col">
    {d.heroImage ? (
      <div class="overflow-hidden">
        <Image
          src={d.heroImage}
          alt={d.heroImageAlt ?? ''}
          widths={[400, 640, 900]}
          sizes="(min-width: 768px) 32vw, 100vw"
          class="h-56 w-full object-cover transition-transform duration-1000 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    ) : (
      /* No stock imagery on posts without a real photograph. A tonal panel
         carrying the category reads as intentional rather than missing. */
      <div class="flex h-56 items-end bg-surface-highest p-6">
        <span class="label-caps text-primary/70">{d.category}</span>
      </div>
    )}

    <div class="flex flex-1 flex-col p-6 md:p-8">
      {d.heroImage && <span class="label-caps mb-4 block text-primary/70">{d.category}</span>}

      <h2 class="mb-3 font-headline text-xl leading-snug text-on-surface md:text-2xl">
        {d.title}
      </h2>
      <p class="mb-6 font-body text-sm leading-relaxed text-on-surface-variant">{d.description}</p>

      <!-- Byline pinned to the bottom so cards of different text lengths
           still line up along the base of the grid row. -->
      <div class="mt-auto flex items-center gap-3">
        <AuthorAvatar size="xs" />
        <div class="flex flex-col">
          <span class="font-body text-xs font-semibold text-on-surface">{AUTHOR.name}</span>
          <time datetime={d.pubDate.toISOString()} class="label-caps text-on-surface-variant/70">
            {date}
          </time>
        </div>
      </div>
    </div>
  </a>
</article>

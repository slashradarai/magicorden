---
import AuthorAvatar from './AuthorAvatar.astro';
import { AUTHOR, BOOKING_URL } from '../config';
import { t, type Locale } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale).blog;
---
<aside class="bg-surface-low p-8 md:p-10">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
    <AuthorAvatar size="lg" />
    <div>
      <span class="label-caps mb-1 block text-primary">{c.aboutAuthor}</span>
      <h2 class="mb-1 font-headline text-xl text-on-surface">{AUTHOR.name}</h2>
      <p class="mb-4 label-caps text-on-surface-variant/70">{AUTHOR.role}</p>
      <p class="mb-5 font-body leading-relaxed text-on-surface-variant">{AUTHOR.bio}</p>
      <a
        href={BOOKING_URL || '/#contacto'}
        {...(BOOKING_URL ? { target: '_blank', rel: 'noopener', 'data-booking': true } : {})}
        class="font-body text-sm font-semibold text-primary underline decoration-primary/35 underline-offset-4 transition-colors hover:decoration-primary"
      >
        {c.workWithMe}
      </a>
    </div>
  </div>
</aside>

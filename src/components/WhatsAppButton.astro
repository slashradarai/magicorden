---
import { CONTACT, WHATSAPP_STYLE } from '../config';
import { t, type Locale } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale).whatsapp;

/* Nothing renders at all when no number is configured, so the button can be
   switched off by blanking CONTACT.whatsapp in config.ts. */
const href = CONTACT.whatsapp
  ? `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(c.prefill)}`
  : '';

const green = WHATSAPP_STYLE === 'green';
---
{href && (
  <a
    href={href}
    target="_blank"
    rel="noopener"
    aria-label={c.label}
    title={c.label}
    class:list={[
      /* Sits below the booking modal (z-100) so the modal covers it cleanly. */
      'group fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full',
      'shadow-ambient transition-all duration-300 hover:scale-105 focus-visible:scale-105 md:bottom-8 md:right-8 md:h-16 md:w-16',
      green ? 'bg-[#25D366] text-white' : 'bg-primary text-on-primary hover:bg-primary-dim',
    ]}
    style="margin-bottom: env(safe-area-inset-bottom);"
  >
    <svg
      viewBox="0 0 24 24"
      fill="currentColor"
      class="h-7 w-7 md:h-8 md:w-8"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652a12.02 12.02 0 0 0 5.71 1.447h.006c6.585 0 11.946-5.336 11.949-11.893a11.82 11.82 0 0 0-3.48-8.453zM12.05 21.785h-.004a9.96 9.96 0 0 1-5.062-1.38l-.363-.215-3.759.98 1.003-3.653-.236-.375a9.86 9.86 0 0 1-1.51-5.27c.002-5.45 4.455-9.885 9.933-9.885a9.86 9.86 0 0 1 7.017 2.9 9.78 9.78 0 0 1 2.896 6.994c-.003 5.45-4.456 9.884-9.915 9.884z"/>
    </svg>
  </a>
)}

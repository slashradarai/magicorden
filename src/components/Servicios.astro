---
import { Image } from 'astro:assets';
import vestidor from '../assets/placeholder-vestidor.png';
import despensa from '../assets/placeholder-despensa.png';
import cocina from '../assets/placeholder-cocina-integral.png';
import { t, type Locale } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale).servicios;

/* Illustrative imagery, not a portfolio. Nothing on this page claims these
   are Kenia's own jobs. Swap for her photography before promoting the site. */
const images = [vestidor, despensa, cocina];
---
<section id="servicios" class="bg-surface-low px-6 py-24 md:px-12 md:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="mb-16 flex flex-col gap-6 md:mb-24 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <span class="label-caps mb-4 block text-primary">{c.eyebrow}</span>
        <h2 class="font-headline text-4xl text-on-surface md:text-5xl">{c.title}</h2>
      </div>
      <p class="max-w-xs font-body text-on-surface-variant md:text-right">{c.note}</p>
    </div>

    <div class="grid grid-cols-1 items-start gap-12 md:grid-cols-12">
      <!-- 01, the wide one -->
      <article class="group md:col-span-7">
        <div class="mb-8 overflow-hidden">
          <Image
            src={images[0]}
            alt={c.items[0].imageAlt}
            widths={[480, 768, 1024]}
            sizes="(min-width: 768px) 58vw, 100vw"
            class="h-[340px] w-full object-cover transition-transform duration-1000 group-hover:scale-105 md:h-[500px]"
            loading="lazy"
          />
        </div>
        <span class="label-caps mb-3 block text-primary/60">{c.items[0].n}</span>
        <h3 class="mb-4 font-headline text-2xl text-on-surface md:text-3xl">{c.items[0].title}</h3>
        <p class="max-w-md font-body leading-relaxed text-on-surface-variant">{c.items[0].body}</p>
      </article>

      <!-- 02, offset down to break the grid -->
      <article class="group md:col-span-5 md:mt-32">
        <div class="mb-8 overflow-hidden">
          <Image
            src={images[1]}
            alt={c.items[1].imageAlt}
            widths={[400, 640, 900]}
            sizes="(min-width: 768px) 40vw, 100vw"
            class="h-[300px] w-full object-cover transition-transform duration-1000 group-hover:scale-105 md:h-[400px]"
            loading="lazy"
          />
        </div>
        <span class="label-caps mb-3 block text-primary/60">{c.items[1].n}</span>
        <h3 class="mb-4 font-headline text-2xl text-on-surface md:text-3xl">{c.items[1].title}</h3>
        <p class="font-body leading-relaxed text-on-surface-variant">{c.items[1].body}</p>
      </article>

      <!-- 03, inset panel -->
      <article
        class="group mt-8 flex flex-col items-center gap-10 bg-surface-container p-8 md:col-span-8 md:col-start-3 md:mt-24 md:flex-row md:p-12"
      >
        <div class="w-full overflow-hidden md:w-1/2">
          <Image
            src={images[2]}
            alt={c.items[2].imageAlt}
            widths={[400, 640, 900]}
            sizes="(min-width: 768px) 34vw, 100vw"
            class="h-[280px] w-full object-cover transition-transform duration-1000 group-hover:scale-105 md:h-[400px]"
            loading="lazy"
          />
        </div>
        <div class="w-full md:w-1/2">
          <span class="label-caps mb-3 block text-primary/60">{c.items[2].n}</span>
          <h3 class="mb-5 font-headline text-2xl text-on-surface md:text-4xl">{c.items[2].title}</h3>
          <p class="mb-8 font-body leading-relaxed text-on-surface-variant">{c.items[2].body}</p>
          <a
            href="#contacto"
            class="inline-block border-2 border-primary px-7 py-3 font-body text-sm text-primary transition-all duration-300 hover:bg-primary hover:text-on-primary"
          >
            {c.cta}
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

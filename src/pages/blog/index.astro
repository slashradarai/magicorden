---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { t } from '../../i18n/ui';

const locale = 'es' as const;
const c = t(locale).blog;

/* Drafts never reach the build. Newest first. */
const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<Base
  locale={locale}
  title={c.metaTitle}
  description={c.metaDescription}
  singleLanguage
>
  <section class="bg-surface px-6 pb-20 pt-32 md:px-12 md:pb-28 md:pt-44">
    <div class="mx-auto max-w-7xl">
      <div class="mb-16 max-w-2xl md:mb-24">
        <span class="label-caps mb-4 block text-primary">{c.eyebrow}</span>
        <h1 class="mb-6 font-headline text-4xl text-on-surface md:text-6xl">{c.title}</h1>
        <p class="font-body text-lg text-on-surface-variant md:text-xl">{c.intro}</p>
      </div>

      {posts.length === 0 ? (
        <p class="font-body text-on-surface-variant">{c.empty}</p>
      ) : (
        <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-8">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )}
    </div>
  </section>
</Base>

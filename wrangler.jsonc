{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "magicorden",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-23",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Deploys come from git, so this file wins over the dashboard.
	// Without this block, enabling logs in the UI is undone by the next push.
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	}
}
